# Telegram userbot (Telethon) — see README.md
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# StringSession from: python scripts/create_session.py
TELEGRAM_SESSION_STRING=

# Supabase (service role — read sources, update last_seen_message_id)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# INUU ingest API (Nuxt dev or production)
INGEST_API_URL=http://127.0.0.1:3000
# Optional; must match NUXT_INGEST_SECRET on the Nuxt side
INGEST_SECRET=

# Rate limit between ingest POSTs (milliseconds)
INGEST_RATE_LIMIT_MS=1000

# Reload active sources from DB every N seconds
SOURCES_RELOAD_SEC=120

# Optional: force ingest one message on startup (smoke test)
# SMOKE_SOURCE_KEY=in.ulanude
# SMOKE_MESSAGE_ID=12345
